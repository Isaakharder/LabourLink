# Loaded only by `vite build --mode android-qa-emulator`. Identical purpose
# to .env.android-qa (a QA-only Android build variant, never touching
# .env.android/the real production APK config) but for the Android
# Studio/AVD EMULATOR specifically rather than a real physical phone: an
# emulator's NAT networking cannot reach the host machine's real LAN IP at
# all (confirmed: ping to the host's LAN address gets "Destination Port
# Unreachable" from inside the AVD) — 10.0.2.2 is the emulator's own fixed
# alias for "the host machine," regardless of the host's actual LAN IP or
# which Wi-Fi network it's on.
VITE_API_URL=http://10.0.2.2:4000

# Reviewer (app-store demo) pairing normally accepts only an https demo API
# (web/src/lib/device.ts normalizeReviewerApiUrl). Local emulator testing runs
# the demo API as plain http on the host, so this QA-only build allows it.
# Never set in .env.android (the real production build).
VITE_ALLOW_HTTP_REVIEWER_API=true
