<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. "development" is correct here:
	     Xcode signs Debug/Run builds against the APNs sandbox, and an
	     App Store Connect / TestFlight export with automatic signing
	     rewrites this to "production" from the distribution profile.
	     The App ID must have Push Notifications enabled in the Apple
	     Developer portal for either profile to carry it. Delivery is
	     server/src/lib/apns.ts (direct APNs, token auth). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Required for lib/nfc.ts's startScanSession to use
	     iosSessionType: "tag" (NFCTagReaderSession) at all — without this
	     entitlement (or with a format missing from the list below) that
	     session type fails to start with a NO_NFC error, even on a device
	     that otherwise has working NFC hardware. TAG is required for raw
	     UID reads (the existing Ridder tags — see nfc.ts's own top-of-file
	     comment and server/migrations/034_nfc_tag_mappings.sql's
	     tag_kind='ridder' column: they carry no NDEF data, so only a TAG
	     session can read them at all). A TAG session also reads and writes
	     LabourLink's own NDEF-written tags (tag_kind='labourlink').

	     TAG only: App Store Connect rejects "NDEF" in this list for apps
	     built with the iOS 27 SDK ("NDEF is disallowed"). The app never
	     opens an NFCNDEFReaderSession on iOS (lib/nfc.ts always passes
	     iosSessionType: "tag"), so nothing needs the NDEF value.

	     THIS ENTITLEMENT MUST ALSO BE ENABLED FOR THE APP ID ITSELF in the
	     Apple Developer portal ("Near Field Communication Tag Reading"
	     capability) before it will take effect on a real device — Xcode's
	     own entitlements file alone is not sufficient; see the iOS NFC
	     readiness report for the exact steps and why provisioning profiles
	     must be regenerated after enabling it. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
