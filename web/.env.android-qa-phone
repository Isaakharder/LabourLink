# Loaded only by `vite build --mode android-qa-phone` (web/package.json's
# build:android-qa-phone script) — a QA-only Android build variant for
# testing on a REAL physical phone connected over USB, as opposed to
# android-qa-emulator (which uses the emulator's fixed 10.0.2.2 host alias)
# or android-qa (which points at the dev machine's LAN IP over Wi-Fi).
# `.env.android` (the real production Android build) is never read or
# modified by this file.
#
# Points at the PHONE'S OWN localhost — deliberately not the dev machine's
# LAN IP. Paired with `adb reverse tcp:4000 tcp:4000`, which tunnels the
# phone's own localhost:4000 back to the dev machine's localhost:4000 over
# the existing USB debugging connection. This sidesteps LAN/Wi-Fi entirely:
# no need to know or guess the dev machine's current LAN IP, no firewall
# rule needed for inbound LAN connections, and it keeps working even if the
# phone isn't on the same Wi-Fi network as the dev machine at all.
VITE_API_URL=http://localhost:4000
