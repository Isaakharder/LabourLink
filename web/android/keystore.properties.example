# Copy this file to keystore.properties (same directory) and fill in real
# values once the release keystore has been generated. keystore.properties
# is git-ignored — never commit real passwords or the keystore path's
# contents here. See android/app/build.gradle for how these are read.
#
# storeFile is resolved relative to THIS directory (android/ — where this
# file and settings.gradle both live), via rootProject.file() in
# app/build.gradle — not relative to android/app/, and not an absolute
# path. If the keystore lives at android/release/labourlink-release.jks,
# the value here is exactly:
#   storeFile=release/labourlink-release.jks
# A relative path (not absolute) is what keeps this working unchanged on
# every machine that builds a release.
#
# Alternative: instead of this file, set these four as environment
# variables before running gradlew — LABOURLINK_RELEASE_STORE_FILE,
# LABOURLINK_RELEASE_STORE_PASSWORD, LABOURLINK_RELEASE_KEY_ALIAS,
# LABOURLINK_RELEASE_KEY_PASSWORD. build.gradle checks this file first,
# then falls back to those environment variables.

storeFile=CHANGE_ME_path_to_keystore.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
