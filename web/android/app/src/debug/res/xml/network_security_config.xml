<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only (see android/app/src/debug/AndroidManifest.xml) — allows
  plain HTTP for local dev testing against a machine's own dev server, not
  used by the release/production build at all (that always talks HTTPS to
  Railway, see web/.env.android). Scoped to exactly the hosts local dev
  already uses (server/.env's CORS_ORIGIN local entries), not a blanket
  cleartext allowance:
    - 10.0.2.2 is the Android emulator's fixed alias for the host
      machine's own localhost.
    - 192.168.2.136 is the same LAN IP already listed in CORS_ORIGIN for a
      phone on the same Wi-Fi hitting the dev machine directly.
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">192.168.2.136</domain>
  </domain-config>
</network-security-config>
