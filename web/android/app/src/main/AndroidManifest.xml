<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false disables BOTH Android's cloud Auto Backup and
         device-to-device transfer for this app's data — per Android's own
         docs, setting it false means the app "never participates in
         backups... even to allow app data restore from device-to-device
         transfers." No separate dataExtractionRules/fullBackupContent is
         needed on top of this; those only matter when allowBackup=true. This
         is deliberate: the WebView's local storage holds this phone's
         pairing credential (device_identifier, web/src/lib/device.ts) — a
         factory reset + Google account restore, or setting up a second
         phone under the same account, must never carry one physical
         device's identity onto another. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required on Android 13+ (API 33) to show notifications at all —
         requested at runtime via @capacitor/push-notifications'
         requestPermissions() (see web/src/lib/push.ts), same as any other
         Android 13+ runtime permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
