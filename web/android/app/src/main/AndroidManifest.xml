<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- allowBackup=false disables BOTH Android's cloud Auto Backup and
         device-to-device transfer for this app's data — per Android's own
         docs, setting it false means the app "never participates in
         backups... even to allow app data restore from device-to-device
         transfers." No separate dataExtractionRules/fullBackupContent is
         needed on top of this; those only matter when allowBackup=true. This
         is deliberate: the WebView's local storage holds this phone's
         pairing credential (device_identifier, web/src/lib/device.ts) — a
         factory reset + Google account restore, or setting up a second
         phone under the same account, must never carry one physical
         device's identity onto another. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Android WebView's Safe Browsing check can perform a live
             lookup against Google's servers for a page's first load in a
             process. Irrelevant for this app (every page it ever loads is
             locally bundled content at https://localhost, never a real
             external site needing phishing/malware protection). Confirmed
             NOT the cause of the cold-start-while-offline hang (see
             MainActivity.java) — kept anyway since it's a harmless,
             correct simplification for an app with no real external
             navigation. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required on Android 13+ (API 33) to show notifications at all —
         requested at runtime via @capacitor/push-notifications'
         requestPermissions() (see web/src/lib/push.ts), same as any other
         Android 13+ runtime permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- @capgo/capacitor-nfc (web/src/lib/nfc.ts). required="false" so the
         APK still installs and runs on farm phones without NFC hardware —
         manual row/bin selection must keep working there; lib/nfc.ts's
         isNfcSupported() is what the UI actually checks at runtime. No NDEF
         intent-filter: scanning is foreground-dispatch only (started/stopped
         while a specific screen is open), never launch-the-app-via-tag-tap. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <!-- lib/feedback.ts's navigator.vibrate() — the instant-registration
         success feedback on RegisterExistingTagScreen. Not declaring this
         doesn't crash anything (vibrate() just silently no-ops), but
         WebView vibration is more reliably granted with it present. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
