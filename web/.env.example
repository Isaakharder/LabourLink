# URL of the LabourLink API (server/). Leave this unset for local dev — with
# no VITE_API_URL, the frontend targets whatever host the page was loaded
# from (see web/src/lib/api.ts), which works correctly whether that's
# localhost or a phone hitting this machine's LAN IP for real-device
# testing. Set it explicitly only for production, where the frontend and API
# live on different domains.
# VITE_API_URL=http://localhost:4000

# --- Supabase project credentials ---
# Not currently read by web code, but reserved for future use of the
# Supabase client. Publishable key is safe for client-side use; project URL
# only — do not append /rest/v1 or any other path.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# IANA timezone the greenhouse operates in — must match the server's
# APP_TIMEZONE. Used by the desktop Inputs page for date defaults, day
# navigation, and end-time correction input. Optional — defaults to
# "America/Toronto" if unset.
# VITE_APP_TIMEZONE=America/Toronto

# --- Web Push (installed PWA / iPhone Home Screen) ---
# The PUBLIC half of the VAPID keypair generated for server/.env's
# VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY — must be the exact same public key on
# both sides. Safe to expose to the client; this is not a secret. Without
# it, SettingsScreen's "Enable notifications" button shows a clear
# "not configured" message instead of attempting a subscription.
VITE_VAPID_PUBLIC_KEY=
