{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabourLink Scale",
  "version": "0.2.1",
  "identifier": "com.labourlink.scale",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LabourLink Scale",
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "width": 1920,
        "height": 1080
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:47800 ws://127.0.0.1:47800; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "LabourLink weighing station",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/labourlink-scaled": "bin/labourlink-scaled",
          "/lib/systemd/system/labourlink-scaled.service": "../../packaging/labourlink-scaled.service",
          "/lib/udev/rules.d/99-labourlink-scale.rules": "../../packaging/99-labourlink-scale.rules",
          "/etc/xdg/autostart/labourlink-scale.desktop": "../../packaging/labourlink-scale-autostart.desktop",
          "/usr/share/labourlink-scale/config.simulation.json": "../../packaging/config.simulation.json",
          "/usr/share/labourlink-scale/config.live.example.json": "../../packaging/config.live.example.json",
          "/usr/share/labourlink-scale/config.hardware-test.json": "../../packaging/config.hardware-test.json",
          "/usr/share/labourlink-scale/setup-kiosk.sh": "../../packaging/setup-kiosk.sh"
        },
        "postInstallScript": "../../packaging/postinst.sh",
        "preRemoveScript": "../../packaging/prerm.sh"
      }
    }
  }
}
