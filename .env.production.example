# Local-network production environment for docker-compose.prod.yml.
#
# Copy this file to .env.production and fill in real values:
#   copy .env.production.example .env.production
#
# .env.production is git-ignored — never commit it. Keep it separate from
# the dev-only root .env so a strong production secret/password never mixes
# with development defaults.

# Generate with PowerShell:
#   -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 48|%{[char]$_})
# or (stronger, cryptographically secure):
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
SESSION_SECRET=change_this_to_a_long_random_string

# PostgreSQL credentials. Change the password before first deployment —
# it is only applied when the database volume is first initialized, so
# changing it later requires a fresh volume or an in-database ALTER ROLE.
POSTGRES_DB=labourlink
POSTGRES_USER=labourlink
POSTGRES_PASSWORD=change_this_strong_password

# Host port the web (nginx) container publishes. 8080 is the safe default —
# Windows machines commonly have something already using port 80 (IIS,
# other services). Set to 80 only after confirming it's free — see
# docs/DEPLOYMENT.md for the exact check.
WEB_PORT=8080

# Must stay "false" for plain local-network HTTP (no TLS) — a "true" value
# makes the browser require HTTPS for the session cookie, which silently
# breaks login on plain HTTP. Only set to "true" once a reverse proxy
# terminates real HTTPS in front of this stack. See docs/DEPLOYMENT.md.
COOKIE_SECURE=false

# Informational only in this nginx-proxied setup (browser traffic to the API
# is same-origin through nginx, so CORS enforcement doesn't apply) — kept for
# defense-in-depth and for any direct API access during troubleshooting.
WEB_ORIGIN=http://localhost:8080

# Host folder for PostgreSQL backups (see scripts/backup-db.ps1). Use
# forward slashes even on Windows — Docker Desktop translates this path.
BACKUP_DIR=C:/LabourLinkBackups
