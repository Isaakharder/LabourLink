{
  "name": "labourlink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db":         "docker compose up -d postgres",
    "dev":        "concurrently --names API,WEB --prefix-colors cyan,yellow \"npm run dev --prefix server\" \"npm run dev --prefix web\"",
    "start-dev":  "npm run db && npm run dev",
    "start-prod": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "stop-prod":  "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "logs-prod":  "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
