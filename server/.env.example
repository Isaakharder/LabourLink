NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=labourlink
DB_USER=labourlink
DB_PASSWORD=labourlink_secret

# Session cookie signing key — use a long random value in any shared environment.
SESSION_SECRET=change_this_to_a_long_random_string

# Origin the web app is served from — required for CORS + cookie handling.
WEB_ORIGIN=http://localhost:3000
