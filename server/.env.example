# Supabase Postgres connection string (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Long random secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Port the API listens on
PORT=4000

# development | production
NODE_ENV=development

# Comma-separated list of allowed origins for the web app (desktop + mobile
# PWA). For real-phone testing on the same Wi-Fi, add this machine's LAN IP
# on the web dev port, e.g. http://localhost:5173,http://192.168.1.23:5173
# (find your IP with `ipconfig` on Windows or `ifconfig`/`ip addr` on
# macOS/Linux — it can change between networks or DHCP renewals).
#
# https://localhost is the Capacitor Android app's WebView origin (see
# web/capacitor.config.ts's androidScheme: "https") — required for the APK
# (debug or release) to reach this API at all. Add it in production too
# (Railway env var on the server service), not just here.
CORS_ORIGIN=http://localhost:5173,https://localhost

# --- Supabase project credentials ---
# SUPABASE_URL is the project URL only — do not append /rest/v1 or any other
# path. SUPABASE_PUBLISHABLE_KEY isn't read by server code (it's the
# client-side/anon key — nothing here uses the Supabase client SDK for
# anything but Storage). SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY ARE
# required — server/src/lib/storage.ts uses them for employee profile
# photos (Supabase Storage). Get the service-role key from Supabase
# Dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Server-only secret. Never expose to the client, never commit the real
# value. Bypasses Row Level Security — treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Storage bucket for employee profile photos. Created automatically on first
# upload if it doesn't exist yet (private, 5MB limit, JPEG/PNG/WebP only).
# Optional — defaults to "employee-profile-photos" if unset.
# SUPABASE_STORAGE_BUCKET=employee-profile-photos

# --- Resend (transactional email) ---
# API key for sending "Forgot PIN" reset emails via Resend (resend.com).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "From" address for reset emails. Must be a verified sender/domain in your
# Resend account, or Resend rejects the send (their shared test sender
# onboarding@resend.dev only delivers to the account owner's own address).
RESEND_FROM_EMAIL="LabourLink <noreply@yourdomain.com>"

# Public URL of the web app (web/), used to build the link inside "forgot
# PIN" reset emails, e.g. https://app.labourlink.example or
# http://localhost:5173 for local dev.
WEB_APP_URL=http://localhost:5173

# IANA timezone the greenhouse operates in. Used by the desktop Inputs page
# to compute calendar-day boundaries and display times — deliberately not
# the server host's or DB session's implicit timezone (Supabase's pooled
# connections default to UTC), since either could be wrong for the actual
# business location. Must match VITE_APP_TIMEZONE in web/.env.example.
# Optional — defaults to "America/Toronto" if unset.
# APP_TIMEZONE=America/Toronto

# --- Optional diagnostics (server/src/routes/diagnostics.ts) ---
# Unset by default; without it the /api/diagnostics/db-check route 404s.
# DIAGNOSTIC_TOKEN=
# DIAGNOSTIC_TRANSACTION_POOLER_URL=

# --- Web Push (VAPID) — server/src/lib/pushDelivery.ts ---
# Required for the installed-PWA "Enable notifications" feature. This is a
# self-generated ECDSA keypair, not a third-party credential — generate one
# with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY must also be set as VITE_VAPID_PUBLIC_KEY in web/.env
# (safe to expose — it's the public half). VAPID_PRIVATE_KEY must never be
# exposed to the web app. VAPID_SUBJECT is a contact URL/mailto the push
# services may use to reach you about this key, e.g. mailto:admin@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Firebase Cloud Messaging (Android push) — server/src/lib/pushDelivery.ts ---
# Required for Android APK push delivery. The full service-account JSON
# (Firebase Console -> Project Settings -> Service Accounts -> Generate new
# private key), as a single-line string. Without this, the server logs a
# warning and skips Android push sends — the mandatory in-app outstanding-
# message fetch still works regardless (push is delivery-alert only, never
# the source of truth). See the project's Firebase setup notes for what
# else is required (google-services.json in web/android/app/).
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
