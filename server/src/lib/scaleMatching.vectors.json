{
  "comment": "Shared cases for the weighing assignment rule. Run by server/src/lib/scaleMatching.test.ts and by the station's scale/service/src/matching.rs (a copy of this file lives at scale/service/src/matching.vectors.json; keep them identical). Times are minutes. receivedAt defaults to occurredAt, clockTrusted to true, consumedBy to null; previous null means the bin's first weighing.",
  "cases": [
    {
      "name": "one employee's bin choice in the cycle credits that employee",
      "weighing": { "id": "w1", "at": 600, "previous": 480, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 540 }],
      "now": 600,
      "expect": { "status": "credited", "employee": "ruben", "consume": ["c1"] }
    },
    {
      "name": "a choice before the previous weighing belongs to the previous cycle",
      "weighing": { "id": "w2", "at": 600, "previous": 480, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 420 }],
      "now": 600,
      "expect": { "status": "pending" }
    },
    {
      "name": "a choice exactly at the previous weighing belongs to the previous cycle",
      "weighing": { "id": "w2", "at": 600, "previous": 480, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 480 }],
      "now": 600,
      "expect": { "status": "pending" }
    },
    {
      "name": "a choice exactly at the weighing counts",
      "weighing": { "id": "w1", "at": 600, "previous": 480, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 600 }],
      "now": 600,
      "expect": { "status": "credited", "employee": "ruben", "consume": ["c1"] }
    },
    {
      "name": "a choice after the weighing does not count",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 601 }],
      "now": 605,
      "expect": { "status": "pending" }
    },
    {
      "name": "a bin's first weighing looks back 24 hours only",
      "weighing": { "id": "w1", "at": 2000, "previous": null, "current": "pending" },
      "claims": [{ "id": "old", "employee": "ruben", "at": 560 }, { "id": "c1", "employee": "maria", "at": 1900 }],
      "now": 2000,
      "expect": { "status": "credited", "employee": "maria", "consume": ["c1"] }
    },
    {
      "name": "no claim stays pending until 24 hours after the weighing",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "pending" },
      "claims": [],
      "now": 2039,
      "expect": { "status": "pending" }
    },
    {
      "name": "no claim 24 hours after the weighing expires uncredited",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "pending" },
      "claims": [],
      "now": 2040,
      "expect": { "status": "expired" }
    },
    {
      "name": "a late-synced choice received within 24 hours recovers the pending weighing",
      "weighing": { "id": "w1", "at": 600, "previous": 360, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "maria", "at": 540, "receivedAt": 1800 }],
      "now": 1800,
      "expect": { "status": "credited", "employee": "maria", "consume": ["c1"] }
    },
    {
      "name": "a choice received after the 24-hour deadline never counts, even before any sweep ran",
      "weighing": { "id": "w1", "at": 600, "previous": 360, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "maria", "at": 540, "receivedAt": 2041 }],
      "now": 2041,
      "expect": { "status": "expired" }
    },
    {
      "name": "expired is final",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "expired" },
      "claims": [{ "id": "c1", "employee": "maria", "at": 540 }],
      "now": 2400,
      "expect": { "status": "expired" }
    },
    {
      "name": "two employees in one cycle need review and nobody is credited",
      "weighing": { "id": "w1", "at": 600, "previous": 480, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 540 }, { "id": "c2", "employee": "maria", "at": 570 }],
      "now": 600,
      "expect": { "status": "needs_review", "competing": ["c1", "c2"] }
    },
    {
      "name": "the same employee choosing twice is still one employee",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 540 }, { "id": "c2", "employee": "ruben", "at": 570 }],
      "now": 600,
      "expect": { "status": "credited", "employee": "ruben", "consume": ["c1", "c2"] }
    },
    {
      "name": "a flagged phone clock never credits",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 540, "clockTrusted": false }],
      "now": 600,
      "expect": { "status": "pending" }
    },
    {
      "name": "a claim consumed by another weighing cannot credit again",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 540, "consumedBy": "w0" }],
      "now": 600,
      "expect": { "status": "pending" }
    },
    {
      "name": "a credit is final; a different employee's late claim is only flagged",
      "weighing": { "id": "w1", "at": 600, "previous": 480, "current": "credited", "employee": "ruben" },
      "claims": [
        { "id": "c1", "employee": "ruben", "at": 540, "consumedBy": "w1" },
        { "id": "c2", "employee": "maria", "at": 510, "receivedAt": 720 }
      ],
      "now": 720,
      "expect": { "status": "credited", "employee": "ruben", "conflicts": ["c2"] }
    },
    {
      "name": "a further choice by the credited employee is absorbed",
      "weighing": { "id": "w1", "at": 600, "previous": 480, "current": "credited", "employee": "ruben" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 540, "consumedBy": "w1" }, { "id": "c3", "employee": "ruben", "at": 550 }],
      "now": 720,
      "expect": { "status": "credited", "employee": "ruben", "consume": ["c3"] }
    },
    {
      "name": "a credit never changes even without its claim",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "credited", "employee": "ruben" },
      "claims": [],
      "now": 2400,
      "expect": { "status": "credited", "employee": "ruben" }
    },
    {
      "name": "needs review is final",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "needs_review" },
      "claims": [{ "id": "c1", "employee": "ruben", "at": 540 }],
      "now": 660,
      "expect": { "status": "needs_review" }
    },
    {
      "name": "voided is final",
      "weighing": { "id": "w1", "at": 600, "previous": null, "current": "voided", "employee": "ruben" },
      "claims": [{ "id": "c1", "employee": "maria", "at": 540 }],
      "now": 660,
      "expect": { "status": "voided", "employee": "ruben" }
    },
    {
      "name": "Bin 77 -> Bin 3 -> Bin 77: a choice synced late credits only the cycle it happened in (cycle 1)",
      "weighing": { "id": "w1", "at": 480, "previous": null, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "maria", "at": 540, "receivedAt": 1740 }],
      "now": 1740,
      "expect": { "status": "pending" }
    },
    {
      "name": "Bin 77 -> Bin 3 -> Bin 77: a choice synced late credits only the cycle it happened in (cycle 2)",
      "weighing": { "id": "w2", "at": 600, "previous": 480, "current": "pending" },
      "claims": [{ "id": "c1", "employee": "maria", "at": 540, "receivedAt": 1740 }],
      "now": 1740,
      "expect": { "status": "credited", "employee": "maria", "consume": ["c1"] }
    }
  ]
}
