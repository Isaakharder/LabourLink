{
  "name": "labourlink-api",
  "version": "0.1.0",
  "description": "LabourLink API server",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "migrate": "node --require ts-node/register src/migrate.ts",
    "create-admin": "node --require ts-node/register src/cli/createCompanyAdmin.ts",
    "lint": "tsc --noEmit",
    "test": "node --require ts-node/register --test src/__tests__/greenhouse-geometry.test.ts src/__tests__/greenhouse-missing-rows.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
