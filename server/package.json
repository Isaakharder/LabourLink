{
  "name": "labourlink-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "ts-node src/migrate.ts",
    "create-admin": "ts-node src/cli/createAdmin.ts",
    "create-greenhouse-display": "ts-node src/cli/createGreenhouseDisplay.ts",
    "cutoff:run": "ts-node src/cli/dailyCutoffRun.ts",
    "cutoff:repair": "ts-node src/cli/repairStaleEntries.ts",
    "typecheck": "tsc --noEmit",
    "test:row-layout": "ts-node src/lib/rowLayout.test.ts",
    "test:daily-cutoff": "ts-node src/lib/dailyCutoff.test.ts",
    "test:work-start-rounding": "ts-node src/lib/workStartRounding.test.ts",
    "test:manual-entries": "ts-node src/routes/inputs.manualEntries.test.ts",
    "test:storage": "ts-node src/lib/storage.test.ts",
    "test:break-reconciliation": "ts-node src/lib/breakReconciliation.test.ts",
    "test:inputs-performance": "ts-node src/routes/inputs.performance.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.11.5",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@types/web-push": "^3.6.4",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
